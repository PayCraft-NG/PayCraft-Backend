{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "PayCraft API",
		"description": "PayCraft REST API — example requests for all controllers.\n\n**Setup:** Set `baseUrl` (e.g. `http://localhost:6020`). Run **Login**; the test script saves `accessToken` and `refreshToken` from `data`.\n\n**Auth:** Most routes need `Authorization: Bearer {{accessToken}}`. Public routes override with **No Auth** (login, refresh, employer signup, company create, webhook, USSD).\n\nAlso available: OpenAPI at `{{baseUrl}}/v3/api-docs` and Swagger UI at `{{baseUrl}}/swagger-ui/index.html`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:6020"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "employerId",
			"value": "11111111-1111-1111-1111-111111111111"
		},
		{
			"key": "employeeId",
			"value": "22222222-2222-2222-2222-222222222222"
		},
		{
			"key": "payrollId",
			"value": "33333333-3333-3333-3333-333333333333"
		},
		{
			"key": "referenceNumber",
			"value": "paycraft-ref-example"
		},
		{
			"key": "cardId",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  const j = pm.response.json();",
									"  if (j.data) {",
									"    if (j.data.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
									"    if (j.data.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
									"  }",
									"} catch (e) {}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailAddress\": \"john.doe@example.com\",\n  \"password\": \"P@ssword1!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/v1/auth/login",
						"description": "Public. Returns `DefaultApiResponse` with `data.accessToken`, `data.refreshToken`, etc."
					},
					"response": []
				},
				{
					"name": "Refresh token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  const j = pm.response.json();",
									"  if (j.data && j.data.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
									"  if (j.data && j.data.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
									"} catch (e) {}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/v1/auth/refresh-token"
					},
					"response": []
				}
			]
		},
